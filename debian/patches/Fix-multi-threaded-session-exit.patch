+++ b/test/test_session_exit.c
@@ -0,0 +1,135 @@
+/*
+ * FUSE: Filesystem in Userspace
+ *
+ * Regression test for multi-threaded session exit (libfuse issue #997).
+ * No mount or /dev/fuse is needed: custom I/O blocks a worker on a pipe.
+ *
+ * This program can be distributed under the terms of the GNU LGPLv2.
+ * See the file COPYING.LIB
+ */
+
+#define FUSE_USE_VERSION 312
+
+#include "fuse_lowlevel.h"
+
+#include <errno.h>
+#include <pthread.h>
+#include <semaphore.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+struct test_state {
+	struct fuse_session *se;
+	sem_t reading;
+	int result;
+	int worker_exit;
+};
+
+static void check(int ok, const char *message)
+{
+	if (!ok) {
+		fprintf(stderr, "%s\n", message);
+		exit(1);
+	}
+}
+
+static ssize_t test_read(int fd, void *buf, size_t size, void *userdata)
+{
+	struct test_state *state = userdata;
+
+	check(sem_post(&state->reading) == 0, "sem_post failed");
+	if (state->worker_exit) {
+		fuse_session_exit(state->se);
+		return 0;
+	}
+	return read(fd, buf, size);
+}
+
+static ssize_t test_writev(int fd, struct iovec *iov, int count,
+			   void *userdata)
+{
+	(void) userdata;
+	return writev(fd, iov, count);
+}
+
+static void *run_loop(void *userdata)
+{
+	struct test_state *state = userdata;
+
+	state->result = fuse_session_loop_mt(state->se, NULL);
+	return NULL;
+}
+
+int main(int argc, char **argv)
+{
+	struct fuse_args args = FUSE_ARGS_INIT(0, NULL);
+	const struct fuse_lowlevel_ops ops = { 0 };
+	const struct fuse_custom_io io = {
+		.read = test_read,
+		.writev = test_writev,
+	};
+	struct test_state state = { 0 };
+	pthread_t loop_thread;
+	int pipefd[2];
+	int use_signal;
+	int iteration;
+	int ret;
+
+	check(argc == 2, "expected direct, signal or worker mode");
+	use_signal = strcmp(argv[1], "signal") == 0;
+	state.worker_exit = strcmp(argv[1], "worker") == 0;
+	check(use_signal || state.worker_exit || strcmp(argv[1], "direct") == 0,
+	      "unknown mode");
+	/* Bound hangs even when invoked without the pytest wrapper. */
+	alarm(10);
+	check(sem_init(&state.reading, 0, 0) == 0, "sem_init failed");
+	check(pipe(pipefd) == 0, "pipe failed");
+	check(fuse_opt_add_arg(&args, argv[0]) == 0, "fuse_opt_add_arg failed");
+	state.se = fuse_session_new(&args, &ops, sizeof(ops), &state);
+	check(state.se != NULL, "fuse_session_new failed");
+	check(fuse_session_custom_io(state.se, &io, pipefd[0]) == 0,
+	      "fuse_session_custom_io failed");
+	if (use_signal)
+		check(fuse_set_signal_handlers(state.se) == 0,
+		      "fuse_set_signal_handlers failed");
+
+	/* Also cover exit/reset before starting a loop. */
+	fuse_session_exit(state.se);
+	check(fuse_session_exited(state.se), "session did not exit");
+	fuse_session_reset(state.se);
+	check(!fuse_session_exited(state.se), "session did not reset");
+
+	/* Reuse the session to check semaphore lifetime and 3.14 reset behavior. */
+	for (iteration = 0; iteration < 10; iteration++) {
+		check(pthread_create(&loop_thread, NULL, run_loop, &state) == 0,
+		      "pthread_create failed");
+		do {
+			ret = sem_wait(&state.reading);
+		} while (ret == -1 && errno == EINTR);
+		check(ret == 0, "sem_wait failed");
+
+		if (use_signal) {
+			/* Deliver to this thread, not the thread in sem_wait(). */
+			check(raise(SIGTERM) == 0, "raise failed");
+		} else if (!state.worker_exit) {
+			fuse_session_exit(state.se);
+		}
+
+		check(pthread_join(loop_thread, NULL) == 0, "pthread_join failed");
+		check(state.result == (use_signal ? SIGTERM : 0),
+		      "unexpected loop exit status");
+		check(!fuse_session_exited(state.se), "loop did not reset session");
+	}
+
+	if (use_signal)
+		fuse_remove_signal_handlers(state.se);
+	fuse_session_destroy(state.se);
+	fuse_opt_free_args(&args);
+	close(pipefd[1]);
+	sem_destroy(&state.reading);
+	alarm(0);
+	return 0;
+}
--- /dev/null
+++ b/test/test_session_exit.py
@@ -0,0 +1,11 @@
+import os
+import subprocess
+
+import pytest
+
+
+@pytest.mark.parametrize('mode', ('direct', 'signal', 'worker'))
+def test_session_exit(mode, output_checker):
+    executable = os.path.join(os.path.dirname(__file__), 'test_session_exit')
+    subprocess.run([executable, mode], stdout=output_checker.fd,
+                   stderr=output_checker.fd, timeout=15, check=True)
